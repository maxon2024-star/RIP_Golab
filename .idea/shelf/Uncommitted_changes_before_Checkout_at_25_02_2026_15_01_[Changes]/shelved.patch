kground: linear-gradient(135deg, var(--success) 0%, #34d399 100%);\r\n    box-shadow: 0 4px 15px rgba(16, 185, 129, 0.4);\r\n}\r\n\r\n/* Request Page */\r\n.request-container {\r\n    padding: 20px;\r\n}\r\n\r\n.request-info-card {\r\n    background: var(--surface);\r\n    border-radius: var(--radius);\r\n    padding: 20px;\r\n    margin-bottom: 20px;\r\n    box-shadow: var(--shadow);\r\n    border: 1px solid var(--border);\r\n}\r\n\r\n.info-header {\r\n    display: flex;\r\n    align-items: center;\r\n    gap: 12px;\r\n    margin-bottom: 16px;\r\n}\r\n\r\n.info-header i {\r\n    font-size: 1.5rem;\r\n    color: var(--primary);\r\n}\r\n\r\n.info-header h2 {\r\n    font-size: 1.2rem;\r\n    font-weight: 600;\r\n    color: var(--text-primary);\r\n}\r\n\r\n.info-grid {\r\n    display: grid;\r\n    grid-template-columns: repeat(3, 1fr);\r\n    gap: 16px;\r\n}\r\n\r\n.info-item {\r\n    display: flex;\r\n    flex-direction: column;\r\n    gap: 4px;\r\n}\r\n\r\n.info-label {\r\n    font-size: 0.85rem;\r\n    color: var(--text-secondary);\r\n}\r\n\r\n.info-value {\r\n    font-size: 1.1rem;\r\n    font-weight: 600;\r\n    color: var(--text-primary);\r\n}\r\n\r\n.info-value.total {\r\n    color: var(--success);\r\n}\r\n\r\n/* Table Header */\r\n.table-header-card {\r\n    background: var(--surface);\r\n    border-radius: var(--radius);\r\n    padding: 16px;\r\n    margin-bottom: 16px;\r\n    box-shadow: var(--shadow);\r\n    border: 1px solid var(--border);\r\n}\r\n\r\n.table-header {\r\n    display: grid;\r\n    grid-template-columns: 80px 1fr 1.5fr 1.5fr 100px 50px;\r\n    gap: 16px;\r\n    font-weight: 600;\r\n    color: var(--text-secondary);\r\n    font-size: 0.85rem;\r\n}\r\n\r\n/* Items Container */\r\n.items-container {\r\n    display: flex;\r\n    flex-direction: column;\r\n    gap: 12px;\r\n    margin-bottom: 20px;\r\n}\r\n\r\n.item-card {\r\n    background: var(--surface);\r\n    border-radius: var(--radius);\r\n    padding: 16px;\r\n    box-shadow: var(--shadow);\r\n    border: 1px solid var(--border);\r\n    transition: all 0.3s;\r\n}\r\n\r\n.item-card:hover {\r\n    box-shadow: var(--shadow-lg);\r\n    border-color: var(--primary-light);\r\n}\r\n\r\n.item-grid {\r\n    display: grid;\r\n    grid-template-columns: 80px 1fr 1.5fr 1.5fr 100px 50px;\r\n    gap: 16px;\r\n    align-items: center;\r\n}\r\n\r\n.item-image {\r\n    width: 60px;\r\n    height: 60px;\r\n    border-radius: var(--radius-sm);\r\n    object-fit: cover;\r\n    border: 1px solid var(--border);\r\n}\r\n\r\n.col-name h4 {\r\n    font-size: 0.95rem;\r\n    font-weight: 600;\r\n    margin-bottom: 4px;\r\n    color: var(--text-primary);\r\n}\r\n\r\n.item-id {\r\n    font-size: 0.75rem;\r\n    color: var(--text-secondary);\r\n}\r\n\r\n.mini-spec {\r\n    display: flex;\r\n    align-items: center;\r\n    gap: 6px;\r\n    font-size: 0.8rem;\r\n    color: var(--text-secondary);\r\n    margin-bottom: 4px;\r\n}\r\n\r\n.mini-spec i {\r\n    color: var(--primary);\r\n    width: 14px;\r\n}\r\n\r\n.param-input {\r\n    display: flex;\r\n    flex-direction: column;\r\n    gap: 4px;\r\n    margin-bottom: 8px;\r\n}\r\n\r\n.param-input.full-width {\r\n    grid-column: 1 / -1;\r\n}\r\n\r\n.param-input label {\r\n    font-size: 0.7rem;\r\n    color: var(--text-secondary);\r\n    font-weight: 500;\r\n}\r\n\r\n.param-input input {\r\n    padding: 6px 8px;\r\n    border: 1px solid var(--border);\r\n    border-radius: 4px;\r\n    font-size: 0.85rem;\r\n    width: 100%;\r\n    background: var(--background);\r\n    transition: all 0.3s;\r\n}\r\n\r\n.param-input input:focus {\r\n    outline: none;\r\n    border-color: var(--primary);\r\n    box-shadow: 0 0 0 2px var(--primary-glow);\r\n}\r\n\r\n.result-value {\r\n    font-size: 1rem;\r\n    font-weight: 700;\r\n    color: var(--success);\r\n    text-shadow: 0 0 10px rgba(16, 185, 129, 0.3);\r\n}\r\n\r\n.remove-btn {\r\n    background: #fee2e2;\r\n    color: var(--accent);\r\n    border: none;\r\n    width: 36px;\r\n    height: 36px;\r\n    border-radius: 50%;\r\n    cursor: pointer;\r\n    display: flex;\r\n    align-items: center;\r\n    justify-content: center;\r\n    transition: all 0.3s;\r\n}\r\n\r\n.remove-btn:hover {\r\n    background: var(--accent);\r\n    color: white;\r\n    transform: scale(1.1);\r\n}\r\n\r\n/* Total Card */\r\n.total-card {\r\n    background: linear-gradient(135deg, var(--secondary) 0%, var(--primary-light) 100%);\r\n    border-radius: var(--radius);\r\n    padding: 20px;\r\n    box-shadow: 0 8px 25px rgba(8, 145, 178, 0.3);\r\n    color: white;\r\n}\r\n\r\n.total-row {\r\n    display: flex;\r\n    justify-content: space-between;\r\n    align-items: center;\r\n    margin-bottom: 16px;\r\n    font-size: 1.1rem;\r\n}\r\n\r\n.total-value {\r\n    font-size: 1.8rem;\r\n    font-weight: 800;\r\n    text-shadow: 0 0 20px rgba(255, 255, 255, 0.5);\r\n}\r\n\r\n.submit-btn {\r\n    width: 100%;\r\n    background: var(--surface);\r\n    color: var(--secondary);\r\n    border: none;\r\n    padding: 16px;\r\n    border-radius: var(--radius-sm);\r\n    font-size: 1rem;\r\n    font-weight: 700;\r\n    cursor: pointer;\r\n    display: flex;\r\n    align-items: center;\r\n    justify-content: center;\r\n    gap: 12px;\r\n    transition: all 0.3s;\r\n    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.2);\r\n}\r\n\r\n.submit-btn:hover {\r\n    transform: translateY(-2px);\r\n    box-shadow: 0 6px 25px rgba(0, 0, 0, 0.25);\r\n}\r\n\r\n/* Bottom Navigation */\r\n.bottom-nav {\r\n    position: fixed;\r\n    bottom: 0;\r\n    left: 0;\r\n    right: 0;\r\n    background: var(--surface);\r\n    display: flex;\r\n    justify-content: space-around;\r\n    padding: 12px 20px;\r\n    box-shadow: 0 -4px 10px -1px rgba(0, 0, 0, 0.1);\r\n    z-index: 100;\r\n    border-top: 1px solid var(--border);\r\n}\r\n\r\n.nav-item {\r\n    display: flex;\r\n    flex-direction: column;\r\n    align-items: center;\r\n    gap: 4px;\r\n    color: var(--text-secondary);\r\n    text-decoration: none;\r\n    font-size: 0.75rem;\r\n    transition: all 0.3s;\r\n}\r\n\r\n.nav-item i {\r\n    font-size: 1.3rem;\r\n}\r\n\r\n.nav-item.active {\r\n    color: var(--primary);\r\n}\r\n\r\n.nav-item.active i {\r\n    text-shadow: 0 0 10px var(--primary-glow);\r\n}\r\n\r\n.nav-item:hover {\r\n    color: var(--primary);\r\n}\r\n\r\n/* Responsive */\r\n@media (max-width: 768px) {\r\n    .table-header,\r\n    .item-grid {\r\n        grid-template-columns: 60px 1fr 80px 50px;\r\n        gap: 12px;\r\n    }\r\n\r\n    .col-specs,\r\n    .col-params {\r\n        display: none;\r\n    }\r\n\r\n    .form-grid {\r\n        grid-template-columns: 1fr;\r\n    }\r\n\r\n    .specs-grid {\r\n        grid-template-columns: 1fr;\r\n    }\r\n\r\n    .info-grid {\r\n        grid-template-columns: 1fr;\r\n    }\r\n\r\n    .bottom-nav {\r\n        padding: 8px 16px;\r\n    }\r\n\r\n    .nav-item span {\r\n        font-size: 0.65rem;\r\n    }\r\n\r\n    .product-image-wrapper {\r\n        height: 220px;\r\n    }\r\n}\r\n\r\n/* ... все предыдущие стили остаются ... */\r\n\r\n/* Vibes Layout - TikTok Style */\r\n.detail-container-vibes {\r\n    padding: 20px;\r\n    max-width: 1200px;\r\n    margin: 0 auto;\r\n}\r\n\r\n.vibes-layout {\r\n    display: grid;\r\n    grid-template-columns: 350px 1fr;\r\n    gap: 20px;\r\n    min-height: auto;\r\n    background: var(--surface);\r\n    border-radius: var(--radius);\r\n    overflow: hidden;\r\n    box-shadow: var(--shadow);\r\n}\r\n\r\n.vibes-video-section {\r\n    position: relative;\r\n    background: #000;\r\n    border-radius: var(--radius);\r\n    overflow: hidden;\r\n}\r\n\r\n.video-wrapper-vertical {\r\n    position: relative;\r\n    width: 100%;\r\n    height: 100%;\r\n    display: flex;\r\n    align-items: center;\r\n    justify-content: center;\r\n}\r\n\r\n.video-container-vertical {\r\n    position: relative;\r\n    width: 100%;\r\n    max-width: 350px;\r\n    aspect-ratio: 9 / 16;\r\n    overflow: hidden;\r\n    border-radius: var(--radius);\r\n    background: #0c4a6e;\r\n    margin: 0 auto;\r\n}\r\n\r\n.video-container-vertical video {\r\n    width: 100%;\r\n    height: 100%;\r\n    object-fit: cover;\r\n    opacity: 0;\r\n    transition: opacity 0.4s ease;\r\n}\r\n\r\n.vibes-actions {\r\n    position: absolute;\r\n    right: 10px;\r\n    bottom: 80px;\r\n    display: flex;\r\n    flex-direction: column;\r\n    gap: 16px;\r\n    z-index: 10;\r\n}\r\n\r\n.action-btn {\r\n    display: flex;\r\n    flex-direction: column;\r\n    align-items: center;\r\n    gap: 4px;\r\n    background: rgba(255, 255, 255, 0.2);\r\n    backdrop-filter: blur(10px);\r\n    border: none;\r\n    color: white;\r\n    width: 50px;\r\n    height: 50px;\r\n    border-radius: 50%;\r\n    cursor: pointer;\r\n    transition: all 0.3s;\r\n    text-decoration: none;\r\n}\r\n\r\n.action-btn:hover {\r\n    background: rgba(255, 255, 255, 0.3);\r\n    transform: scale(1.1);\r\n}\r\n\r\n.action-btn i {\r\n    font-size: 1.2rem;\r\n}\r\n\r\n.action-btn span {\r\n    font-size: 0.7rem;\r\n    font-weight: 600;\r\n}\r\n\r\n.vibes-info-section {\r\n    background: var(--surface);\r\n    padding: 24px;\r\n    overflow-y: auto;\r\n    max-height: calc(100vh - 200px);\r\n}\r\n\r\n.vibes-content {\r\n    max-width: 100%;\r\n}\r\n\r\n.vibes-specs {\r\n    display: grid;\r\n    grid-template-columns: repeat(2, 1fr);\r\n    gap: 12px;\r\n    margin-bottom: 24px;\r\n}\r\n\r\n.vibes-spec-item {\r\n    display: flex;\r\n    align-items: center;\r\n    gap: 12px;\r\n    padding: 14px;\r\n    background: var(--background);\r\n    border-radius: var(--radius-sm);\r\n    border: 1px solid var(--border);\r\n}\r\n\r\n.vibes-spec-item i {\r\n    font-size: 1.5rem;\r\n    color: var(--primary);\r\n    width: 35px;\r\n    text-align: center;\r\n}\r\n\r\n.vibes-spec-item .spec-label {\r\n    display: block;\r\n    font-size: 0.7rem;\r\n    color: var(--text-secondary);\r\n    margin-bottom: 4px;\r\n}\r\n\r\n.vibes-spec-item .spec-value {\r\n    font-size: 0.9rem;\r\n    font-weight: 600;\r\n    color: var(--text-primary);\r\n}\r\n\r\n.vibes-action-bar {\r\n    position: static;\r\n    background: transparent;\r\n    padding: 0;\r\n    box-shadow: none;\r\n    border: none;\r\n    margin-top: 20px;\r\n}\r\n\r\n/* Video Loader */\r\n.video-loader {\r\n    position: absolute;\r\n    top: 0;\r\n    left: 0;\r\n    right: 0;\r\n    bottom: 0;\r\n    background: linear-gradient(135deg, #f0f9ff 0%, #e0f2fe 100%);\r\n    border-radius: var(--radius);\r\n    display: flex;\r\n    align-items: center;\r\n    justify-content: center;\r\n    z-index: 2;\r\n}\r\n\r\n.spinner {\r\n    width: 40px;\r\n    height: 40px;\r\n    border: 4px solid #bae6fd;\r\n    border-top: 4px solid var(--primary);\r\n    border-radius: 50%;\r\n    animation: spin 1s linear infinite;\r\n}\r\n\r\n@keyframes spin {\r\n    100% { transform: rotate(360deg); }\r\n}\r\n\r\n.no-video {\r\n    display: flex;\r\n    flex-direction: column;\r\n    align-items: center;\r\n    justify-content: center;\r\n    height: 100%;\r\n    color: var(--text-secondary);\r\n}\r\n\r\n.no-video i {\r\n    font-size: 2.5rem;\r\n    margin-bottom: 12px;\r\n    color: var(--primary);\r\n}\r\n\r\n.no-video p {\r\n    font-size: 0.9rem;\r\n}\r\n\r\n/* Responsive for Vibes Layout */\r\n@media (max-width: 1024px) {\r\n    .vibes-layout {\r\n        grid-template-columns: 1fr;\r\n        grid-template-rows: auto auto;\r\n    }\r\n\r\n    .vibes-video-section {\r\n        max-width: 350px;\r\n        margin: 0 auto;\r\n    }\r\n\r\n    .vibes-actions {\r\n        right: 15px;\r\n        bottom: 90px;\r\n    }\r\n\r\n    .vibes-info-section {\r\n        max-height: none;\r\n    }\r\n\r\n    .vibes-specs {\r\n        grid-template-columns: 1fr;\r\n    }\r\n}\r\n\r\n@media (max-width: 768px) {\r\n    .detail-container-vibes {\r\n        padding: 10px;\r\n    }\r\n\r\n    .vibes-video-section {\r\n        max-width: 100%;\r\n    }\r\n\r\n    .video-container-vertical {\r\n        max-width: 280px;\r\n    }\r\n\r\n   