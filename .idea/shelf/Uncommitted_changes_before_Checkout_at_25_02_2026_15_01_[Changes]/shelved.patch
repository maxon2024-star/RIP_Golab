<+><!DOCTYPE html>\r\n<html lang=\"ru\">\r\n<head>\r\n    <meta charset=\"UTF-8\">\r\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\r\n    <title>Заявка на расчет - Фотоэффект</title>\r\n    <link rel=\"stylesheet\" href=\"/static/style.css\">\r\n    <link rel=\"stylesheet\" href=\"https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css\">\r\n</head>\r\n<body>\r\n<div class=\"app-container\">\r\n    <header class=\"main-header\">\r\n        <div class=\"header-top\">\r\n            <h1 class=\"app-title\">⚡ Фотоэффект</h1>\r\n            <div class=\"header-actions\">\r\n                {{if .logged_in}}\r\n                <span class=\"user-info\">\uD83D\uDC64 {{.login}}</span>\r\n                <button class=\"logout-btn\" onclick=\"logout()\">Выйти</button>\r\n                {{else}}\r\n                <button class=\"login-btn\" onclick=\"window.location.href='/'\">Войти</button>\r\n                {{end}}\r\n                <a href=\"/\" class=\"cart-icon\">\r\n                    <i class=\"fas fa-home\"></i>\r\n                </a>\r\n            </div>\r\n        </div>\r\n    </header>\r\n\r\n    <main class=\"request-container\">\r\n        <div class=\"request-info-card\">\r\n            <div class=\"info-header\">\r\n                <i class=\"fas fa-clipboard-list\"></i>\r\n                <h2>Параметры заявки на эксперимент</h2>\r\n            </div>\r\n            <div class=\"info-grid\">\r\n                <div class=\"info-item\">\r\n                    <span class=\"info-label\">Номер заявки</span>\r\n                    <span class=\"info-value\">#<span id=\"request-id\">0</span></span>\r\n                </div>\r\n                <div class=\"info-item\">\r\n                    <span class=\"info-label\">Диапазонов излучения</span>\r\n                    <span class=\"info-value\" id=\"ranges-count\">0</span>\r\n                </div>\r\n                <div class=\"info-item\">\r\n                    <span class=\"info-label\">Общий ток фотоэффекта</span>\r\n                    <span class=\"info-value total\" id=\"total-current\">0 мА</span>\r\n                </div>\r\n            </div>\r\n        </div>\r\n\r\n        <div class=\"table-header-card\">\r\n            <div class=\"table-header\">\r\n                <div class=\"col-image\">Изображение</div>\r\n                <div class=\"col-name\">Диапазон излучения</div>\r\n                <div class=\"col-specs\">Характеристики</div>\r\n                <div class=\"col-params\">Параметры эксперимента</div>\r\n                <div class=\"col-result\">Ток фотоэффекта</div>\r\n                <div class=\"col-action\"></div>\r\n            </div>\r\n        </div>\r\n\r\n        <div id=\"cart\" class=\"items-container\">\r\n            <div class=\"empty-cart\" id=\"emptyCart\" style=\"display:none;\">\r\n                <i class=\"fas fa-shopping-cart\"></i>\r\n                <p>Заявка пуста</p>\r\n                <a href=\"/\" class=\"browse-btn\">Добавить диапазоны</a>\r\n            </div>\r\n        </div>\r\n\r\n        <div class=\"total-card\" id=\"totalCard\" style=\"display:none;\">\r\n            <div class=\"total-row\">\r\n                <span>Суммарный ток фотоэлектронов:</span>\r\n                <span class=\"total-value\" id=\"final-total\">0 мА</span>\r\n            </div>\r\n            <button class=\"submit-btn\" onclick=\"submitRequest()\">\r\n                <i class=\"fas fa-paper-plane\"></i>\r\n                <span>Отправить расчет</span>\r\n            </button>\r\n        </div>\r\n    </main>\r\n\r\n    <nav class=\"bottom-nav\">\r\n        <a href=\"/\" class=\"nav-item\">\r\n            <i class=\"fas fa-home\"></i>\r\n            <span>Главная</span>\r\n        </a>\r\n        <a href=\"/request\" class=\"nav-item active\">\r\n            <i class=\"fas fa-file-alt\"></i>\r\n            <span>Заявка</span>\r\n        </a>\r\n    </nav>\r\n</div>\r\n\r\n<script>\r\n    let radiationRanges = [];\r\n    let currentRequestId = 0;\r\n\r\n    async function loadRequest() {\r\n        const response = await fetch('/request?format=json');\r\n        if (response.ok) {\r\n            const data = await response.json();\r\n            radiationRanges = data.items || [];\r\n            currentRequestId = data.request_id || 0;\r\n// ✅ Устанавливаем номер заявки\r\n            document.getElementById('request-id').textContent = currentRequestId;\r\n            render();\r\n        }\r\n    }\r\n\r\n    function render() {\r\n        const cart = document.getElementById(\"cart\");\r\n        const emptyCart = document.getElementById(\"emptyCart\");\r\n        const totalCard = document.getElementById(\"totalCard\");\r\n        cart.innerHTML = \"\";\r\n        let totalCurrent = 0;\r\n\r\n        if (radiationRanges.length === 0) {\r\n            emptyCart.style.display = \"block\";\r\n            totalCard.style.display = \"none\";\r\n            document.getElementById(\"ranges-count\").textContent = \"0\";\r\n            document.getElementById(\"total-current\").textContent = \"0 мА\";\r\n            document.getElementById(\"final-total\").textContent = \"0 мА\";\r\n            return;\r\n        }\r\n\r\n        emptyCart.style.display = \"none\";\r\n        totalCard.style.display = \"block\";\r\n\r\n        radiationRanges.forEach(range => {\r\n            const rad = range.Radiation || range.radiation || {};\r\n\r\n// ✅ Получаем частоту для расчёта (из Radiation или дефолтное значение)\r\n            const frequencyStr = rad.Frequency || rad.frequency || '0';\r\n            const freqValue = parseFrequency(frequencyStr); // Парсим строку типа \"3 кГц - 300 ГГц\"\r\n\r\n            const intensity = range.Intensity || range.intensity || rad.Intensity || rad.intensity || 100;\r\n            const area = (range.Area || range.area || 0) > 0 ? (range.Area || range.area) : 10;\r\n            const workFunction = (range.WorkFunction || range.work_function || 0) > 0 ? (range.WorkFunction || range.work_function) : 2.3;\r\n            const efficiency = (range.Efficiency || range.efficiency || 0) > 0 ? (range.Efficiency || range.efficiency) : 18;\r\n            const comment = range.Comment || range.comment || '';\r\n\r\n// ✅ Расчёт тока с учётом частоты (I = Intensity × Area × Efficiency × FrequencyFactor / 1000)\r\n            const frequencyFactor = freqValue > 0 ? Math.min(freqValue / 1e14, 10) : 1; // Нормализация частоты\r\n            const current = (intensity * area * efficiency * frequencyFactor) / 1000;\r\n            totalCurrent += current;\r\n\r\n            cart.innerHTML += `\r\n<div class=\"item-card\">\r\n<div class=\"item-grid\">\r\n<div class=\"col-image\">\r\n<img src=\"${rad.ImageURL || rad.image_url || 'https://via.placeholder.com/80'}\"\r\nalt=\"${rad.Name || rad.name || 'Диапазон'}\"\r\nclass=\"item-image\"\r\nonerror=\"this.src='https://via.placeholder.com/80?text=No+Image'\">\r\n</div>\r\n<div class=\"col-name\">\r\n<h4>${rad.Name || rad.name || 'Диапазон #' + (range.RadiationID || range.radiation_id)}</h4>\r\n<span class=\"item-id\">#${range.RadiationID || range.radiation_id}</span>\r\n</div>\r\n<div class=\"col-specs\">\r\n<div class=\"mini-spec\">\r\n<i class=\"fas fa-bolt\"></i>\r\n<span>${rad.EnergyRange || rad.energy_range || '-'}</span>\r\n</div>\r\n<div class=\"mini-spec\">\r\n<i class=\"fas fa-wave-square\"></i>\r\n<span>${rad.Wavelength || rad.wavelength || '-'}</span>\r\n</div>\r\n<div class=\"mini-spec\">\r\n<i class=\"fas fa-broadcast-tower\"></i>\r\n<span>${rad.Frequency || rad.frequency || '-'}</span>\r\n</div>\r\n</div>\r\n<div class=\"col-params\">\r\n<div class=\"param-input\">\r\n<label>Интенсивность (Вт/м²)</label>\r\n<input type=\"number\" value=\"${intensity}\" min=\"0\" step=\"0.1\"\r\nonchange=\"updateRange(${range.ID || range.id}, ${range.RequestID || range.request_id}, ${range.RadiationID || range.radiation_id}, 'intensity', this.value)\">\r\n</div>\r\n<div class=\"param-input\">\r\n<label>Площадь катода (см²)</label>\r\n<input type=\"number\" value=\"${area}\" min=\"0.1\" step=\"0.1\"\r\nonchange=\"updateRange(${range.ID || range.id}, ${range.RequestID || range.request_id}, ${range.RadiationID || range.radiation_id}, 'area', this.value)\">\r\n</div>\r\n<div class=\"param-input\">\r\n<label>Работа выхода (эВ)</label>\r\n<input type=\"number\" value=\"${workFunction}\" min=\"0.1\" step=\"0.1\"\r\nonchange=\"updateRange(${range.ID || range.id}, ${range.RequestID || range.request_id}, ${range.RadiationID || range.radiation_id}, 'work_function', this.value)\">\r\n</div>\r\n<div class=\"param-input\">\r\n<label>Эффективность (%)</label>\r\n<input type=\"number\" value=\"${efficiency}\" min=\"0\" max=\"100\" step=\"0.1\"\r\nonchange=\"updateRange(${range.ID || range.id}, ${range.RequestID || range.request_id}, ${range.RadiationID || range.radiation_id}, 'efficiency', this.value)\">\r\n</div>\r\n<div class=\"param-input full-width\">\r\n<label>Описание эксперимента</label>\r\n<input type=\"text\" value=\"${comment}\" placeholder=\"Параметры опыта.\"\r\nonchange=\"updateRange(${range.ID || range.id}, ${range.RequestID || range.request_id}, ${range.RadiationID || range.radiation_id}, 'comment', this.value)\">\r\n</div>\r\n</div>\r\n<div class=\"col-result\">\r\n<span class=\"result-value\">${current.toFixed(2)} мА</span>\r\n</div>\r\n<div class=\"col-action\">\r\n<button class=\"remove-btn\" onclick=\"removeRange(${range.RadiationID || range.radiation_id})\">\r\n<i class=\"fas fa-trash\"></i>\r\n</button>\r\n</div>\r\n</div>\r\n</div>\r\n`;\r\n        });\r\n\r\n        document.getElementById(\"ranges-count\").textContent = radiationRanges.length;\r\n        document.getElementById(\"total-current\").textContent = totalCurrent.toFixed(2) + \" мА\";\r\n        document.getElementById(\"final-total\").textContent = totalCurrent.toFixed(2) + \" мА\";\r\n    }\r\n\r\n    // ✅ Функция парсинга частоты из строки типа \"3 кГц - 300 ГГц\"\r\n    function parseFrequency(freqStr) {\r\n        if (!freqStr) return 0;\r\n        const match = freqStr.match(/([\\d.]+)\\s*(кГц|МГц|ГГц|ТГц|ПГц)/i);\r\n        if (!match) return 0;\r\n        const value = parseFloat(match[1]);\r\n        const unit = match[2].toLowerCase();\r\n        const multipliers = {\r\n            'кГц': 1e3,\r\n            'мгц': 1e6,\r\n            'ггц': 1e9,\r\n            'тгц': 1e12,\r\n            'пгц': 1e15\r\n        };\r\n        return value * (multipliers[unit] || 1);\r\n    }\r\n\r\n    async function updateRange(itemId, requestId, radiationId, property, value) {\r\n        const num = Number(value);\r\n        const payloadValue = !isNaN(num) ? num : value;\r\n        const body = {\r\n            id: itemId,\r\n            request_id: requestId,\r\n            radiation_id: radiationId\r\n        };\r\n        body[property] = payloadValue;\r\n\r\n        const response = await fetch('/update-request', {\r\n            method: 'POST',\r\n            headers: {'Content-Type': 'application/json'},\r\n            body: JSON.stringify(body)\r\n        });\r\n        if (response.ok) {\r\n            for (let i = 0; i < radiationRanges.length; i++) {\r\n                const r = radiationRanges[i];\r\n                const idMatch = (r.ID || r.id) === itemId;\r\n                const radiationMatch = (r.RadiationID || r.radiation_id) === radiationId;\r\n                if (idMatch || radiationMatch) {\r\n                    r[property] = payloadValue;\r\n                    const camel = property.split('_').map((w, idx) => idx === 0 ? w : w[0].toUpperCase() + w.slice(1)).join('');\r\n                    r[camel] = payloadValue;\r\n                    const intensity = r.Intensity || r.intensity || (r.Radiation && (r.Radiation.Intensity || r.Radiation.intensity)) || 0;\r\n                    const area = r.Area || r.area || 10;\r\n                    const efficiency = r.Efficiency || r.efficiency || 18;\r\n                    const freqStr = r.Radiation ? (r.Radiation.Frequency || r.Radiation.frequency) : '';\r\n                    const freqValue = parseFrequency(freqStr);\r\n                    const frequencyFactor = freqValue > 0 ? Math.min(freqValue / 1e14, 10) : 1;\r\n                    r.CalculatedCurrent = intensity * area * efficiency * frequencyFactor / 1000;\r\n                    break;\r\n                }\r\n            }\r\n            render();\r\n        } else {\r\n            const data = await response.json();\r\n            alert('Ошибка: ' + (data.error || 'Не удалось обновить'));\r\n        }\r\n    }\r\n\r\n    async function removeRange(radiationId) {\r\n        const response = await fetch('/remove-from-request', {\r\n            method: 'POST',\r\n            headers: {'Content-Type': 'application/json'},\r\n            body: JSON.stringify({radiation_id: radiationId})\r\n        });\r\n        if (response.ok) {\r\n            radiationRanges = radiationRanges.filter(r => (r.RadiationID || r.radiation_id) !== radiationId);\r\n            render();\r\n        }\r\n    }\r\n\r\n    async function submitRequest() {\r\n        if(!confirm(\"Отправить заявку на проверку модератору?\")) return;\r\n\r\n        const reqId = currentRequestId > 0 ? currentRequestId : parseInt(document.getElementById('request-id').textContent);\r\n        const response = await fetch('/request/status', {\r\n            method: 'POST',\r\n            headers: {'Content-Type': 'application/json'},\r\n            body: JSON.stringify({request_id: reqId, status: 'сформирован'})\r\n        });\r\n\r\n        if(response.ok) {\r\n            alert('Заявка отправлена! Создан новый черновик.');\r\n// ✅ Очищаем локальные данные и перезагружаем\r\n            radiationRanges = [];\r\n            currentRequestId = 0;\r\n            location.reload();\r\n        } else {\r\n            alert('Ошибка отправки');\r\n        }\r\n    }\r\n\r\n    async function logout() {\r\n        await fetch('/logout', {method: 'POST'});\r\n        location.reload();\r\n    }\r\n\r\n    document.addEventListener('DOMContentLoaded', () => {\r\n        loadRequest();\r\n    });\r\n</script>\r\n</body>\r\n</html>
